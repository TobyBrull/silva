# Adoption of
# https://doc.rust-lang.org/reference/grammar.html
# as of 2026-10-01.
#
# Major deviations from the reference grammar:
#  * Rust forbids struct expressions (Expr.Struct) in some places; this is called the
#    NO_STRUCT_LITERAL restriction. For example, in « if MyStruct {} {} » the « MyStruct {} »
#    could be a struct literal followed by an empty block. Since Rust has the NO_STRUCT_LITERAL
#    restriction for if conditions, though, this will be parsed as only « MyStruct » being the if
#    condition, followed by the if-block, followed by an empty block. The same restriction also
#    stops a « { » from being taken as the end of a range, as in « for i in 0.. {} ».
#    Seed can't (yet) express such context-dependent restrictions, so Rose approximates them:
#    everywhere, a « { » after a path only starts a struct expression if it is followed by
#    « name: », « name, », « 0: » or « .. ». Consequently « Foo {} » and « Foo { x } » are never
#    struct expressions, « if x == Foo { a: 1 } {} » is accepted, and « for i in 0.. {} »
#    doesn't parse (the block becomes the end of the range). Resolving this needs two variants of
#    the expression axe (with and without the restriction), which is to be addressed with
#    parameterized rules/scopes at some point.
#  * The Rust grammar treats expressions with blocks (e.g., « if », « match », « loop ») specially
#    when they are used as statements or as match-arm bodies. Here, such an expression ends the
#    statement (or match-arm) unless it is followed by '.' or '?'. In particular, such an
#    expression at the end of a block becomes a statement instead of the block's tail expression.
#  * Raw strings support at most two '#'.

language Rose:
  skip.@ = whitespace

  whitespace = no_node [ comment NEWLINE SPACE LINE_CONTINUATION INDENT DEDENT INDENTATION_BROKEN ] *
  comment:
    @ = no_node line | block
    line = no_node '//' ( LANGUAGE | ANY ) *
    block = no_node '/*' ( block | not '*/' anyFragment ) * '*/'
  anyFragment = no_node [ ANY NEWLINE INDENT DEDENT INDENTATION_BROKEN LINE_CONTINUATION ]

  @ = InnerAttr * Item *

  # Lexical structure

  identifier = rawIdentifier | not keyword anyIdentifier
  rawIdentifier = no_node ε 'r#' anyIdentifier
  anyIdentifier = no_node ID_START ID_CONTINUE *
  keyword = no_node [ "as" "async" "await" "break" "const" "continue" "crate" "dyn" "else" "enum" \
                      "extern" "false" "fn" "for" "if" "impl" "in" "let" "loop" "match" "mod" \
                      "move" "mut" "pub" "ref" "return" "self" "Self" "static" "struct" "super" \
                      "trait" "true" "type" "unsafe" "use" "where" "while" "_" ]
  pathKeyword = [ "super" "self" "Self" "crate" ]
  selfValue = "self"
  safety = [ "safe" "unsafe" ]
  mut = "mut"
  ref = "ref"
  underscore = "_"
  colon = no_node ε ':' not ':'
  lifetime = ε '\'' anyIdentifier not '\''

  literal = no_node [ string char number boolean ]
  boolean = [ "true" "false" ]

  string:
    @ = no_node [ plain byte cRaw c raw byteRaw ]
    plain = quoted
    byte = ε 'b' quoted
    c = ε 'c' quoted
    cRaw = ε 'cr' rawQuoted
    raw = ε 'r' rawQuoted
    byteRaw = ε 'br' rawQuoted
    quoted = no_node '"' ( '\\' ANY | not '"' anyFragment ) * '"'
    rawQuoted = no_node '##"' ( not '"##' anyFragment ) * '"##' \
                      | '#"' ( not '"#' anyFragment ) * '"#' \
                      | '"' ( not '"' anyFragment ) * '"'

  char:
    @ = no_node [ plain byte ]
    plain = ε '\'' body '\''
    byte = ε 'b\'' body '\''
    body = no_node '\\' ( 'u{' ( not '}' ANY ) * '}' | ANY ) | not [ '\'' '\\' ] ANY

  number:
    @ = body suffix ? not ID_CONTINUE
    body = no_node [ binary octal hexadecimal float decimal ]
    binary = '0b' [ '0' '1' '_' ] +
    octal = '0o' [ DIGIT '_' ] +
    hexadecimal = '0x' [ DIGIT 'a' 'b' 'c' 'd' 'e' 'f' 'A' 'B' 'C' 'D' 'E' 'F' '_' ] +
    float = decimal ( exponent | ε '.' decimal exponent ? | ε '.' not [ '.' ID_START ] )
    exponent = [ 'e' 'E' ] [ '+' '-' ] ? decimal
    decimal = DIGIT [ DIGIT '_' ] *
    suffix = [ 'u' 'i' 'f' ] ( DIGIT + | 'size' )

  # Token trees and attributes

  DelimTokenTree = ε '(' TokenTree * ')' | ε '[' TokenTree * ']' | '{' TokenTree * '}'
  TokenTree = DelimTokenTree | token
  token = [ string char lifetime number rawIdentifier anyIdentifier OPERATOR ]

  InnerAttr = '#' '!' '[' Attr ']'
  OuterAttr = '#' '[' Attr ']'
  Attr = ε "unsafe" '(' SimplePath AttrInput ? ')' | SimplePath AttrInput ?
  AttrInput = DelimTokenTree | '=' Expr

  # Paths

  SimplePath = '::' ? simplePathSegment ( ε '::' simplePathSegment ) *
  simplePathSegment = identifier | pathKeyword | '$' "crate"
  PathIdentSegment = no_node identifier | pathKeyword | '$' "crate"

  PathInExpr = '::' ? PathExprSegment ( ε '::' PathExprSegment ) *
  PathExprSegment = PathIdentSegment ( ε '::' GenericArgs ) ?

  QualifiedPathType = '<' Type ( "as" TypePath ) ? '>'
  QualifiedPathInExpr = QualifiedPathType ( ε '::' PathExprSegment ) +
  QualifiedPathInType = QualifiedPathType ( ε '::' TypePathSegment ) +

  TypePath = '::' ? TypePathSegment ( ε '::' TypePathSegment ) *
  TypePathSegment = PathIdentSegment ( '::' ? ( GenericArgs | TypePathFn ) ) ?
  TypePathFn = '(' ( Type ( ε ',' Type ) * ',' ? ) ? ')' ( '->' Type.NoBounds ) ?

  GenericArgs:
    @ = '<' ( Arg ( ε ',' Arg ) * ',' ? ) ? '>'
    Arg = lifetime | Constraint | Type | Const
    Constraint = identifier GenericArgs ? ( '=' Type | colon Bounds )
    Const = Block | '-' ? literal

  # Items

  Item = OuterAttr * ( MacroRules | MacroItem | Visibility ? VisItem )
  VisItem = no_node [ Module ExternCrate Use Function TypeAlias Struct Enum Union Const Static Trait \
              Impl ExternBlock ]

  Visibility = "pub" ( ε '(' pathKeyword ')' | ε '(' "in" SimplePath ')' ) ?

  Module = "mod" identifier ( ';' | '{' InnerAttr * Item * '}' )

  ExternCrate = "extern" "crate" ( identifier | pathKeyword ) ( "as" ( identifier | underscore ) ) ? ';'

  Use:
    @ = "use" Tree ';'
    Tree = ( SimplePath ? '::' ) ? ( glob | '{' ( Tree ( ε ',' Tree ) * ',' ? ) ? '}' ) \
         | SimplePath ( "as" ( identifier | underscore ) ) ?
    glob = '*'

  Function:
    @ = Qualifiers "fn" ~ identifier GenericParams ? '(' Params ? ')' ( '->' Type ) ? Where ? \
        ( Block | ';' )
    Qualifiers = no_node constness ? asyncness ? safety ? ( "extern" abi ? ) ?
    constness = "const"
    asyncness = "async"
    abi = string
    Params = SelfParam ( ε ',' Param ) * ',' ? | Param ( ε ',' Param ) * ',' ?
    SelfParam = OuterAttr * ( TypedSelf | ShorthandSelf )
    TypedSelf = mut ? selfValue colon Type
    ShorthandSelf = ( '&' lifetime ? ) ? mut ? selfValue
    Param = OuterAttr * ( Pattern.Bind colon ( Type | variadic ) | variadic | Type )
    variadic = '...'

  TypeAlias = "type" identifier GenericParams ? ( colon Bounds ) ? Where ? ( '=' Type Where ? ) ? ';'

  Struct:
    @ = "struct" identifier GenericParams ? ( Where ? Fields | TupleFields Where ? ';' | Where ? ';' )
    Fields = '{' ( Field ( ε ',' Field ) * ',' ? ) ? '}'
    Field = OuterAttr * Visibility ? identifier colon Type
    TupleFields = '(' ( TupleField ( ε ',' TupleField ) * ',' ? ) ? ')'
    TupleField = OuterAttr * Visibility ? Type

  Enum:
    @ = "enum" identifier GenericParams ? Where ? '{' ( Variant ( ε ',' Variant ) * ',' ? ) ? '}'
    Variant = OuterAttr * Visibility ? identifier ( Struct.Fields | Struct.TupleFields ) ? \
              ( '=' Expr ) ?

  Union = ε "union" identifier GenericParams ? Where ? Struct.Fields

  Const = ε "const" ( identifier | underscore ) colon ~ Type ( '=' Expr ) ? ';'

  Static = safety ? "static" ~ mut ? identifier colon Type ( '=' Expr ) ? ';'

  Trait = "unsafe" ? "auto" ? "trait" ~ identifier GenericParams ? ( colon Bounds ? ) ? Where ? \
          '{' InnerAttr * AssocItem * '}'

  Impl = "unsafe" ? "impl" ~ GenericParams ? ( negative ? TypePath "for" Type | Type ) Where ? \
         '{' InnerAttr * AssocItem * '}'
  negative = '!'

  AssocItem = OuterAttr * ( MacroItem | Visibility ? [ TypeAlias Const Function ] )

  ExternBlock = "unsafe" ? "extern" Function.abi ? '{' ~ InnerAttr * ExternItem * '}'
  ExternItem = OuterAttr * ( MacroItem | Visibility ? [ Static Function ] )

  MacroItem = SimplePath '!' not '=' ( ε '(' TokenTree * ')' ';' | ε '[' TokenTree * ']' ';' \
                                     | '{' TokenTree * '}' )

  MacroRules:
    @ = "macro_rules" '!' identifier ( '(' Rules ')' ';' | '[' Rules ']' ';' | '{' Rules '}' )
    Rules = MacroRule ( ε ';' MacroRule ) * ';' ?
    MacroRule = Matcher '=>' DelimTokenTree
    Matcher = ε '(' Match * ')' | ε '[' Match * ']' | '{' Match * '}'
    Match = Fragment | Repetition | Matcher | not '$' token
    Fragment = ε '$' ( identifier | underscore ) colon fragSpec
    Repetition = '$' '(' Match + ')' separator ? repOp
    fragSpec = [ "block" "expr_2021" "expr" "ident" "item" "lifetime" "literal" "meta" "pat_param" \
                 "pat" "path" "stmt" "tt" "ty" "vis" ]
    separator = not repOp not '$' token
    repOp = [ '*' '+' '?' ]

  # Generics

  GenericParams:
    @ = '<' ( Param ( ε ',' Param ) * ',' ? ) ? '>'
    Param = OuterAttr * [ LifetimeParam ConstParam TypeParam ]
    LifetimeParam = lifetime ( colon LifetimeBounds ) ?
    TypeParam = identifier ( colon Bounds ? ) ? ( '=' Type ) ?
    ConstParam = "const" identifier colon Type ( '=' GenericArgs.Const ) ?

  Where:
    @ = "where" ( Predicate ( ε ',' Predicate ) * ',' ? ) ?
    Predicate = lifetime colon LifetimeBounds | ForLifetimes ? Type colon Bounds ?

  ForLifetimes = ε "for" GenericParams
  LifetimeBounds = lifetime ( ε '+' lifetime ) * '+' ?
  Bounds = Bound ( ε '+' Bound ) * '+' ?
  Bound = lifetime | ε '(' TraitBound ')' | TraitBound
  TraitBound = maybe ? ForLifetimes ? TypePath
  maybe = '?'

  # Types

  Type:
    @ = no_node [ ImplTrait TraitObject NoBounds ]
    NoBounds = no_node [ ImplTraitOneBound TraitObjectOneBound never Ref Pointer Array Slice Paren \
                         Tuple underscore BareFunction QualifiedPathInType Macro TypePath ]
    ImplTrait = "impl" Bounds
    TraitObject = "dyn" Bounds
    ImplTraitOneBound = "impl" Bound
    TraitObjectOneBound = "dyn" Bound
    never = '!'
    Ref = '&' lifetime ? mut ? NoBounds
    Pointer = '*' pointerKind NoBounds
    pointerKind = [ "const" "mut" ]
    Array = ε '[' Type ';' Expr ']'
    Slice = '[' Type ']'
    Paren = ε '(' Type ')'
    Tuple = '(' ( Type ( ε ',' Type ) * ',' ? ) ? ')'
    BareFunction = ForLifetimes ? Function.Qualifiers "fn" ~ '(' Params ? ')' ( '->' NoBounds ) ?
    Params = Param ( ε ',' Param ) * ( ε ',' Function.variadic ) ? ',' ?
    Param = OuterAttr * ( ε ( identifier | underscore ) colon ) ? Type
    Macro = SimplePath '!' DelimTokenTree

  # Statements

  Block = '{' InnerAttr * Stmt * Expr ? '}'

  Stmt:
    @ = [ empty Let Item ExprStmt ]
    empty = ';'
    Let = OuterAttr * "let" ~ Pattern.Bind ( colon Type ) ? ( '=' Expr ( "else" Block ) ? ) ? ';'
    ExprStmt = OuterAttr * ( BlockLike not [ '.' '?' ] ';' ? | Expr ';' )

  BlockLike = no_node [ Expr.Unsafe Expr.ConstBlock Expr.Labeled Block Expr.If \
                        Expr.Match Expr.Loop Expr.While Expr.For ]

  # Expressions

  Expr:
    @ = axe Atom
      Member  = ltr  postfix_nest -> CallArgs '(' ')' \
                     postfix_nest '[' ']' \
                     postfix '?' ".await" \
                     postfix_nest -> FieldName '.' none
      Unary   = rtl  prefix '-' '!' '*' \
                     prefix_nest -> RefKind '&' none \
                     prefix_nest -> RefKind '&&' none
      Cast    = ltr  postfix_nest -> Type.NoBounds "as" none
      Product = ltr  infix '*' '/' '%'
      Sum     = ltr  infix '+' '-'
      Shift   = ltr  infix '<<' '>>'
      BitAnd  = ltr  infix '&'
      BitXor  = ltr  infix '^'
      BitOr   = ltr  infix '|'
      Compare = ltr  infix '==' '!=' '<=' '>=' '<' '>'
      LazyAnd = ltr  infix_flat '&&'
      LazyOr  = ltr  infix_flat '||'
      Range   = rtl  infix_open '..=' '..'
      Assign  = rtl  infix '=' '+=' '-=' '*=' '/=' '%=' '&=' '|=' '^=' '<<=' '>>='

    Atom = no_node [ literal Closure Async Unsafe ConstBlock Labeled Block If Match Loop While \
                     For Return Break Continue Paren Tuple Array Macro Struct \
                     QualifiedPathInExpr PathInExpr ]

    CallArgs = ( Expr ( ε ',' Expr ) * ',' ? ) ?
    FieldName = tupleIndex | PathExprSegment
    tupleIndex = DIGIT + not ID_CONTINUE
    RefKind = ( mut | ε "raw" Type.pointerKind ) ?

    Closure = ForLifetimes ? "async" ? "move" ? ( '||' | '|' ( ClosureParam ( ε ',' ClosureParam ) * ',' ? ) ? '|' ) \
              ( '->' Type.NoBounds Block | Expr )
    ClosureParam = OuterAttr * Pattern.Bind ( colon Type ) ?

    Async = "async" "move" ? Block
    Unsafe = "unsafe" Block
    ConstBlock = "const" Block
    Labeled = lifetime ':' ~ ( Loop | While | For | Block )

    If = "if" Conditions Block ( "else" ( Block | If ) ) ?
    Conditions = LetChain | Expr
    LetChain = ( Expr.Compare '&&' ) * LetCondition ( ε '&&' ( LetCondition | Expr.Compare ) ) *
    LetCondition = "let" '|' ? Pattern '=' Expr.Compare

    Match = "match" Expr '{' InnerAttr * Arm * '}'
    Arm = OuterAttr * '|' ? Pattern ( "if" Expr.Range ) ? '=>' ( BlockLike not [ '.' '?' ] ',' ? | Expr ( ',' | not not '}' ) )

    Loop = "loop" Block
    While = "while" Conditions Block
    For = "for" Pattern "in" Expr Block

    Return = "return" Expr ?
    Break = "break" lifetime ? Expr ?
    Continue = "continue" lifetime ?

    Paren = ε '(' Expr ')'
    Tuple = '(' ( Expr ( ε ',' Expr ) * ',' ? ) ? ')'
    Array = '[' ( ε Expr ';' Expr | Expr ( ε ',' Expr ) * ',' ? ) ? ']'

    Macro = PathInExpr '!' not '=' DelimTokenTree

    Struct = PathInExpr '{' not not StructStart \
             ( Field ( ε ',' Field ) * ( ε ',' Base ) ? ',' ? | Base ) '}'
    StructStart = identifier colon | identifier ',' | number colon | ε '..' not '='
    Field = OuterAttr * ( ε identifier colon Expr | ε number colon Expr | identifier )
    Base = '..' Expr

  # Patterns

  Pattern:
    @ = axe Atom
      Ref   = rtl  prefix_nest -> RefKind '&' none '&&' none
      Range = rtl  infix_open '..=' '..'
      Bind  = rtl  infix '@'
      Alt   = ltr  infix_flat '|'

    Atom = no_node [ Literal underscore Macro Struct TupleStruct Ident Grouped Tuple Slice \
                     QualifiedPathInExpr PathInExpr ]
    Literal = '-' ? literal
    RefKind = mut ?
    rest = '..'
    Macro = PathInExpr '!' DelimTokenTree
    Ident = ref ? mut ? identifier not [ '::' '(' '{' '!' ]
    TupleStruct = PathInExpr '(' ( Pattern ( ε ',' Pattern ) * ',' ? ) ? ')'
    Grouped = ε '(' Pattern ')'
    Tuple = '(' ( Pattern ( ε ',' Pattern ) * ',' ? ) ? ')'
    Slice = '[' ( Pattern ( ε ',' Pattern ) * ',' ? ) ? ']'
    Struct = PathInExpr '{' ( Field ( ε ',' Field ) * ( ε ',' rest ) ? ',' ? | rest ) ? '}'
    Field = OuterAttr * ( ε identifier colon Pattern | ε number colon Pattern | ref ? mut ? identifier )
