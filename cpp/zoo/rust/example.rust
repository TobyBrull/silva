const NUMBERS: [u64; 9] = [0, 1_000, 0b1010, 0o755, 0xdead_BEEF, 42u8 as u64, 7usize as u64, 1e3 as u64, 2.5e-3f64 as u64];
const _: () = ();
static GREETING: &'static str = "hello \"world\"\n";
static BYTES: &[u8] = b"bytes\x00";
static RAW: &str = r#"raw "quoted" string"#;
static RAW2: &str = r##"even "# more"##;
static CHARS: [char; 4] = ['a', '\n', '\'', '\u{1F600}'];
